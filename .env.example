# Copy to .env and fill in. Never commit .env.
# Both values come from your Supabase project: Project Settings → Data API (URL) and API Keys.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Safe to ship in the app; row level security protects the data.
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...). Only used by backend/seed.ts on your machine. Never prefix with EXPO_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
